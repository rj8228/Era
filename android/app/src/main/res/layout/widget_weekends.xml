<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="12dp">
    <TextView android:id="@+id/w_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Weekends left" android:textColor="#1B1F33" android:textSize="16sp" android:textStyle="bold" />
    <ImageView android:id="@+id/w_dots" android:layout_width="match_parent" android:layout_height="28dp"
        android:layout_marginTop="6dp" android:layout_marginBottom="6dp"
        android:contentDescription="@string/w_weekends_desc" android:scaleType="fitStart" />
    <TextView android:id="@+id/w_next" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="" android:textColor="#5A6075" android:textSize="12sp" />
</LinearLayout>
